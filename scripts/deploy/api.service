[Unit]
Description=Image Processing API (FastAPI + uvicorn)
After=network.target rabbitmq-server.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/image-processing-system/api
EnvironmentFile=/home/ubuntu/.env.api
ExecStart=/home/ubuntu/image-processing-system/api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
